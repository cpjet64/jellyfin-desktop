set(stage "@PACKAGE_STAGE@")
set(portable "@PACKAGE_PORTABLE@")
set(temp "@PACKAGE_TEMP@")
if(PACKAGE_KIND STREQUAL "installer")
  set(candidate "${temp}/@INSTALLER_BASE_NAME@.exe")
  set(destination "@PACKAGE_INSTALLER@")
  execute_process(COMMAND "@ISCC@" "/O${temp}" "/F@INSTALLER_BASE_NAME@"
    "@CMAKE_CURRENT_BINARY_DIR@/JellyfinDesktop.iss" RESULT_VARIABLE result)
elseif(PACKAGE_KIND STREQUAL "zip")
  set(candidate "${temp}/@INSTALLER_BASE_NAME@.zip")
  set(destination "@PACKAGE_ZIP@")
  file(MAKE_DIRECTORY "${portable}")
  file(GLOB children "${stage}/*")
  foreach(child ${children})
    get_filename_component(name "${child}" NAME)
    if(NOT name STREQUAL "redist" AND NOT name STREQUAL "vc_redist.x64.exe")
      file(COPY "${child}" DESTINATION "${portable}")
    endif()
  endforeach()
  file(GLOB runtime "${stage}/redist/*.dll")
  if(NOT runtime)
    message(FATAL_ERROR "Windows package stage has no runtime DLLs")
  endif()
  file(COPY ${runtime} DESTINATION "${portable}")
  file(WRITE "${portable}/portable" "")
  execute_process(COMMAND "@CMAKE_COMMAND@" -E tar cf "${candidate}" --format=zip .
    WORKING_DIRECTORY "${portable}" RESULT_VARIABLE result)
else()
  message(FATAL_ERROR "Unknown Windows package kind: ${PACKAGE_KIND}")
endif()
if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${candidate}")
  message(FATAL_ERROR "Windows ${PACKAGE_KIND} packaging failed: ${result}")
endif()
file(SIZE "${candidate}" size)
if(size EQUAL 0)
  message(FATAL_ERROR "Windows ${PACKAGE_KIND} package is empty")
endif()
if(PACKAGE_KIND STREQUAL "installer")
  if(size LESS 68)
    message(FATAL_ERROR "Windows installer is too small to be an executable")
  endif()
  file(READ "${candidate}" header OFFSET 0 LIMIT 64 HEX)
  string(SUBSTRING "${header}" 0 4 signature)
  if(NOT signature STREQUAL "4d5a")
    message(FATAL_ERROR "Windows installer is not an executable")
  endif()
  string(SUBSTRING "${header}" 120 2 b0)
  string(SUBSTRING "${header}" 122 2 b1)
  string(SUBSTRING "${header}" 124 2 b2)
  string(SUBSTRING "${header}" 126 2 b3)
  math(EXPR pe_offset "0x${b3}${b2}${b1}${b0}")
  math(EXPR pe_end "${pe_offset} + 4")
  if(pe_offset LESS 64 OR pe_end GREATER size)
    message(FATAL_ERROR "Windows installer has an invalid executable header")
  endif()
  file(READ "${candidate}" pe_signature OFFSET ${pe_offset} LIMIT 4 HEX)
  if(NOT pe_signature STREQUAL "50450000")
    message(FATAL_ERROR "Windows installer has an invalid executable signature")
  endif()
elseif(PACKAGE_KIND STREQUAL "zip")
  execute_process(COMMAND "@CMAKE_COMMAND@" -E tar tf "${candidate}"
    OUTPUT_QUIET RESULT_VARIABLE valid)
  if(NOT "${valid}" STREQUAL "0")
    message(FATAL_ERROR "Windows portable ZIP is invalid")
  endif()
endif()
file(RENAME "${candidate}" "${destination}")
