  file(MAKE_DIRECTORY "${_healthy_copy}")
endif()

foreach(_entry IN LISTS _healthy_input_pins)
  string(REPLACE "|" ";" _pair "${_entry}")
  list(GET _pair 0 _source_relative)
  list(GET _pair 1 _target_relative)
  list(GET _pair 2 _expected_hash)
  _healthy_path("${CMAKE_SOURCE_DIR}" "${_source_relative}" _source)
  _healthy_path("${_healthy_copy}" "${_target_relative}" _target)
  _healthy_read("${_source}" "${_expected_hash}" _contents)
  _healthy_rewrite("${_target_relative}" "${_contents}" _rewritten)
  get_filename_component(_target_dir "${_target}" DIRECTORY)
  file(MAKE_DIRECTORY "${_target_dir}")
  _healthy_path("${_healthy_copy}" "${_target_relative}" _target)
  file(WRITE "${_target}" "${_rewritten}")
endforeach()

