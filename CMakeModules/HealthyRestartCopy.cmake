    string(REPLACE "|" ";" _pair "${_entry}")
    list(GET _pair 0 _relative)
    list(GET _pair 1 _expected_hash)
    _healthy_path("${_healthy_copy}" "${_relative}" _output)
    _healthy_read("${_output}" "${_expected_hash}" _unused)
  endforeach()
