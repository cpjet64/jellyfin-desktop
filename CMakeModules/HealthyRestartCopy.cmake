# Reject links/reparse redirection on each existing path before any write.
function(_healthy_path base relative output)
  if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)" OR relative MATCHES "(^|/)\\.(/|$)")
    message(FATAL_ERROR "Unsafe healthy copy path: ${relative}")
  endif()
  file(REAL_PATH "${base}" _actual_base)
  cmake_path(ABSOLUTE_PATH base NORMALIZE OUTPUT_VARIABLE _expected_base)
  if(WIN32)
    string(TOLOWER "${_actual_base}" _actual_base)
    string(TOLOWER "${_expected_base}" _expected_base)
  endif()
  if(NOT _actual_base STREQUAL _expected_base)
    message(FATAL_ERROR "Healthy copy base is redirected: ${base}")
  endif()
  set(_current "${base}")
  string(REPLACE "/" ";" _parts "${relative}")
  foreach(_part IN LISTS _parts)
    if(_part STREQUAL "")
      message(FATAL_ERROR "Empty healthy copy path component")
    endif()
    string(APPEND _current "/${_part}")
    if(IS_SYMLINK "${_current}")
      message(FATAL_ERROR "Healthy copy path is linked: ${_current}")
    endif()
    if(EXISTS "${_current}")
      file(REAL_PATH "${_current}" _actual)
      cmake_path(ABSOLUTE_PATH _current NORMALIZE OUTPUT_VARIABLE _expected)
      if(WIN32)
        string(TOLOWER "${_actual}" _actual)
        string(TOLOWER "${_expected}" _expected)
      endif()
      if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Healthy copy path is redirected: ${_current}")
      endif()
    endif()
  endforeach()
  set(${output} "${_current}" PARENT_SCOPE)
endfunction()

function(_healthy_read source expected output)
  if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}" OR IS_SYMLINK "${source}")
    message(FATAL_ERROR "Healthy copy input missing or linked: ${source}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(READ "${source}" _data)
  string(REPLACE "\r\n" "\n" _data "${_data}")
  string(SHA256 _hash "${_data}")
  if(NOT _hash STREQUAL expected)
    message(FATAL_ERROR "Healthy copy hash mismatch: ${source}")
  endif()
  set(${output} "${_data}" PARENT_SCOPE)
endfunction()

function(_healthy_rewrite name input output)
  set(_rewrite_paths core/ComponentManager.cpp ui/WindowManager.cpp input/InputComponent.cpp
      power/PowerComponent.cpp mpris/MprisComponent.cpp mpris/MprisComponent.h
      input/apple/InputAppleMediaKeys.h input/apple/InputAppleMediaKeys.mm
      settings/AudioSettingsController.cpp taskbar/TaskbarComponentWin.cpp)
  set(_data "${input}")
  if(name IN_LIST _rewrite_paths)
    if(name MATCHES "^input/apple/")
      set(_prefix "../../player/")
    else()
      set(_prefix "../player/")
    endif()
    string(REPLACE "\"player/PlayerComponent.h\"" "\"${_prefix}PlayerComponent.h\"" _data "${_data}")
    string(REPLACE "\"player/AlbumArtProvider.h\"" "\"${_prefix}AlbumArtProvider.h\"" _data "${_data}")
    string(REPLACE "\"PlayerComponent.h\"" "\"${_prefix}PlayerComponent.h\"" _data "${_data}")
    if(_data STREQUAL input)
      message(FATAL_ERROR "Expected healthy include rewrite missing: ${name}")
    endif()
  endif()
  set(${output} "${_data}" PARENT_SCOPE)
endfunction()

function(_healthy_apply relative expected rewrite_mpv)
  _healthy_path("${CMAKE_SOURCE_DIR}" "${relative}" _patch)
  _healthy_read("${_patch}" "${expected}" _contents)
  if(rewrite_mpv)
    string(REPLACE "a/src/" "a/mpvqt/" _contents "${_contents}")
    string(REPLACE "b/src/" "b/mpvqt/" _contents "${_contents}")
  endif()
  get_filename_component(_name "${relative}" NAME)
  _healthy_path("${_healthy_copy}" ".patch-${_name}" _copy)
  file(WRITE "${_copy}" "${_contents}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${CMAKE_BINARY_DIR}"
    "${GIT_EXECUTABLE}" apply --no-index --unidiff-zero --whitespace=nowarn "${_copy}"
    WORKING_DIRECTORY "${_healthy_copy}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Healthy copy patch failed: ${_name}: ${_error}")
  endif()
endfunction()

