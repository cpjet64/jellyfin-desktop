# The definition is internal evidence of this configure-time check, not a cache option.
unset(JELLYFIN_VERIFIED_RECOVERY_KIT CACHE)
set(JELLYFIN_VERIFIED_RECOVERY_KIT OFF)

function(require_qt_include_inside_kit include_path qt_root)
  if(include_path MATCHES "\\$<" OR NOT IS_DIRECTORY "${include_path}")
    message(FATAL_ERROR "Qt include path is unresolved")
  endif()
  get_filename_component(_include_real "${include_path}" REALPATH)
  file(RELATIVE_PATH _include_relative "${qt_root}" "${_include_real}")
  if(IS_ABSOLUTE "${_include_relative}" OR _include_relative MATCHES "^\\.\\.(/|$)")
    message(FATAL_ERROR "Qt include path is outside the verified kit")
  endif()
endfunction()

function(verify_recovery_kit)
  if(NOT DEFINED ENV{JELLYFIN_RECOVERY_ARTIFACT_REQUIRED} OR "$ENV{JELLYFIN_RECOVERY_ARTIFACT_REQUIRED}" STREQUAL "")
    return()
  endif()
  if(NOT "$ENV{JELLYFIN_RECOVERY_ARTIFACT_REQUIRED}" STREQUAL "1" OR
     NOT WIN32 OR NOT USE_STATIC_MPVQT OR NOT MPVQT_EXTERNAL_EVENTS OR
     MPVQT_C2_DIAGNOSTIC_ONLY OR PLAYER_INTENT_DIAGNOSTIC_ONLY OR FIXTURE_PRODUCER_COPY_ONLY)
    message(FATAL_ERROR "Verified recovery kit requires the normal bundled Windows MpvQt path")
  endif()
  get_property(_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(_multi OR NOT CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo)$")
    message(FATAL_ERROR "Verified recovery kit requires a single Release or RelWithDebInfo configuration")
  endif()
  list(LENGTH MPV_LIBRARY _mpv_library_count)
  list(LENGTH MPV_INCLUDE_DIR _mpv_include_count)
  if(NOT _mpv_library_count EQUAL 1 OR NOT _mpv_include_count EQUAL 1 OR
     NOT IS_DIRECTORY "${QTROOT}" OR NOT EXISTS "${Qt6_DIR}/Qt6Config.cmake")
    message(FATAL_ERROR "Configured Qt/mpv paths are incomplete or ambiguous")
  endif()
  get_filename_component(_mpv_library "${MPV_LIBRARY}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
  get_filename_component(_mpv_dir "${_mpv_library}" DIRECTORY)
  get_filename_component(_mpv_root "${_mpv_dir}/.." ABSOLUTE)
  get_filename_component(_qt_root "${QTROOT}" REALPATH)
  set(_qt_args)
  foreach(_module Core Gui Quick OpenGL)
    set(_version_var "Qt6${_module}_VERSION")
    if(NOT "${${_version_var}}" STREQUAL "6.9.3" OR NOT TARGET "Qt6::${_module}")
      message(FATAL_ERROR "Verified recovery kit requires Qt 6.9.3 ${_module}")
    endif()
    get_target_property(_implib "Qt6::${_module}" IMPORTED_IMPLIB_RELEASE)
    get_target_property(_runtime "Qt6::${_module}" IMPORTED_LOCATION_RELEASE)
    if(NOT EXISTS "${_implib}" OR NOT EXISTS "${_runtime}")
      message(FATAL_ERROR "Qt ${_module} release import library or runtime is unavailable")
    endif()
    if(CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
      get_target_property(_mapped "Qt6::${_module}" MAP_IMPORTED_CONFIG_RELWITHDEBINFO)
      if(NOT "${_mapped}" STREQUAL "Release" AND NOT "${_mapped}" STREQUAL "RELEASE")
        message(FATAL_ERROR "Qt ${_module} RelWithDebInfo mapping is not explicitly Release")
      endif()
    endif()
    get_target_property(_includes "Qt6::${_module}" INTERFACE_INCLUDE_DIRECTORIES)
    foreach(_include IN LISTS _includes)
      require_qt_include_inside_kit("${_include}" "${_qt_root}")
    endforeach()
    list(APPEND _qt_args --qt-artifact "${_implib}" --qt-artifact "${_runtime}")
  endforeach()
  if(NOT Qt6Gui_PRIVATE_INCLUDE_DIRS)
    message(FATAL_ERROR "Qt Gui private include paths are unavailable")
  endif()
  foreach(_include IN LISTS Qt6Gui_PRIVATE_INCLUDE_DIRS)
    require_qt_include_inside_kit("${_include}" "${_qt_root}")
  endforeach()
  find_program(_recovery_py NAMES py.exe REQUIRED)
  execute_process(
    COMMAND "${_recovery_py}" -3 "${CMAKE_SOURCE_DIR}/patches/mpv/build/recovery_artifacts.py" verify
      --lock "$ENV{JELLYFIN_RECOVERY_LOCK}" --approved-lock-sha256 "$ENV{JELLYFIN_RECOVERY_LOCK_SHA256}"
      --root "${_mpv_root}" --qt-root "${_qt_root}" --manifest "$ENV{JELLYFIN_RECOVERY_MANIFEST}"
      --approved-manifest-sha256 "$ENV{JELLYFIN_RECOVERY_MANIFEST_SHA256}" --dumpbin "$ENV{JELLYFIN_RECOVERY_DUMPBIN}"
      --configured-mpv-library "${_mpv_library}" --configured-mpv-include "${MPV_INCLUDE_DIR}"
      --qt-config "${Qt6_DIR}/Qt6Config.cmake" ${_qt_args}
    RESULT_VARIABLE _result
  )
  if(NOT "${_result}" STREQUAL "0")
    message(FATAL_ERROR "Configured recovery kit verification failed")
  endif()
  set(JELLYFIN_VERIFIED_RECOVERY_KIT ON PARENT_SCOPE)
endfunction()

verify_recovery_kit()
