if(APPLE)
  set(SCRIPT CompleteBundleMac)
elseif(WIN32)
  set(SCRIPT CompleteBundleWin)
endif(APPLE)

option(CODE_SIGN "code sign the app" OFF)
if(CODE_SIGN)
  set(DO_SIGN 1)
else(CODE_SIGN)
  set(DO_SIGN 0)
endif(CODE_SIGN)

if(ENABLE_ANGLE_DEP)
  set(DO_ENABLE_ANGLE_DEP 1)
else()
  set(DO_ENABLE_ANGLE_DEP 0)
endif()

if(SCRIPT)
  if(WIN32)
    if(NOT USE_STATIC_MPVQT AND TARGET MpvQt::MpvQt)
      get_target_property(_mpvqt_type MpvQt::MpvQt TYPE)
      if(_mpvqt_type STREQUAL "SHARED_LIBRARY")
        install(FILES "$<TARGET_FILE:MpvQt::MpvQt>" DESTINATION "${INSTALL_BIN_DIR}")
      endif()
    endif()
    string(REPLACE "\\" "/" _bundle_mpv_library "${MPV_LIBRARY}")
    get_filename_component(BUNDLE_MPV_LIBRARY "${_bundle_mpv_library}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
    string(REPLACE "\\" "/" BUNDLE_CEC_LIBRARY "${CEC_LIBRARY}")
    configure_file(${CMAKE_SOURCE_DIR}/CMakeModules/ValidateWindowsRuntime.cmake.in ${CMAKE_BINARY_DIR}/ValidateWindowsRuntime.cmake @ONLY)
  endif()
  configure_file(${CMAKE_SOURCE_DIR}/CMakeModules/${SCRIPT}.cmake.in ${SCRIPT}.cmake @ONLY)
  install(SCRIPT ${CMAKE_CURRENT_BINARY_DIR}/${SCRIPT}.cmake)
endif(SCRIPT)
