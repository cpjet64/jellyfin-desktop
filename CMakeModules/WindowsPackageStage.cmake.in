set(work "@PACKAGE_WORK@")
set(stage "@PACKAGE_STAGE@")
file(REMOVE "@PACKAGE_INSTALLER@" "@PACKAGE_ZIP@")
if(EXISTS "@PACKAGE_INSTALLER@" OR EXISTS "@PACKAGE_ZIP@")
  message(FATAL_ERROR "Could not invalidate existing Windows packages")
endif()
# Build only after invalidation. The outer package target does not depend on
# the application, so this nested build cannot recurse into packaging.
set(build_command "@CMAKE_COMMAND@" --build "@CMAKE_CURRENT_BINARY_DIR@" --target JellyfinDesktop)
if(NOT "${PACKAGE_CONFIG}" STREQUAL "")
  list(APPEND build_command --config "${PACKAGE_CONFIG}")
endif()
execute_process(COMMAND ${build_command} RESULT_VARIABLE build_result)
if(NOT "${build_result}" STREQUAL "0")
  message(FATAL_ERROR "Windows package application build failed: ${build_result}")
endif()
file(REMOVE_RECURSE "${work}")
if(EXISTS "${work}")
  message(FATAL_ERROR "Could not clear the Windows package staging directory")
endif()
file(MAKE_DIRECTORY "${stage}" "@PACKAGE_TEMP@")
execute_process(COMMAND "@CMAKE_COMMAND@" "-DCMAKE_INSTALL_PREFIX=${stage}"
  "-DCMAKE_INSTALL_CONFIG_NAME=${PACKAGE_CONFIG}" -P "@CMAKE_CURRENT_BINARY_DIR@/cmake_install.cmake"
  RESULT_VARIABLE result)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Windows package staging failed: ${result}")
endif()
