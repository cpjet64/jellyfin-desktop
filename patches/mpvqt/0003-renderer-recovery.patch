+static qint64 steadyMilliseconds()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static bool sameFrame(const QtRecoveryFrameV1 &a, const QtRecoveryFrameV1 &b)
+{
+    return a.size == sizeof(a) && a.version == QT_RECOVERY_SUBMISSION_ABI_VERSION && !a.reserved &&
+        a.attempt == b.attempt && a.renderer_generation == b.renderer_generation &&
+        a.entry_id == b.entry_id && a.discontinuity_id == b.discontinuity_id &&
+        a.source_frame_serial == b.source_frame_serial && a.render_serial == b.render_serial &&
+        a.media_pts == b.media_pts && a.actual_render_fbo == b.actual_render_fbo;
+}
+
+static bool pollUnsupported(const std::shared_ptr<RendererRuntime::GenerationOwner> &generation,
+                            const std::shared_ptr<RecoveryExchange> &exchange,
+                            const std::shared_ptr<QtSubmissionBridge::Resolver> &resolver)
+{
+    QtRecoverySwapTicketV1 ticket{};
+    {
+        std::lock_guard<std::mutex> lock(exchange->mutex);
+        if (!exchange->owns(generation, generation->generation) || !exchange->bootstrapSupported) return false;
+        ticket = exchange->submission.ticket;
+    }
+    if (!resolver->takeUnsupported(ticket.window_lifetime, generation->generation,
+                                   ticket.scenegraph_generation)) return false;
+    bool notify = false;
+    {
+        std::lock_guard<std::mutex> lock(exchange->mutex);
+        if (exchange->owns(generation, generation->generation) && exchange->bootstrapSupported &&
+            exchange->submission.ticket.window_lifetime == ticket.window_lifetime &&
+            exchange->submission.ticket.scenegraph_generation == ticket.scenegraph_generation) {
+            exchange->bootstrapSupported = false;
+            exchange->sourceFrameSerial = 0;
+            exchange->submissions.clear();
+            exchange->capabilityFailurePending = true;
+            exchange->capabilityFailureGeneration = generation->generation;
+            notify = true;
+        }
+    }
+    if (notify) generation->notifyRenderUpdate();
+    return true;
+}
+
+static void takeSubmission(const std::shared_ptr<RendererRuntime::GenerationOwner> &generation,
+                           const std::shared_ptr<RecoveryExchange> &exchange,
+                           const std::shared_ptr<QtSubmissionBridge::Resolver> &resolver)
+{
+    if (pollUnsupported(generation, exchange, resolver)) return;
+    QtRecoverySwapTicketV1 ticket{};
+    QtRecoveryFrameV1 frame{};
+    quint64 operationId = 0;
+    {
+        std::lock_guard<std::mutex> lock(exchange->mutex);
+        if (!generation->observerAuthority.load() || exchange->owner.lock() != generation ||
+            !exchange->ticketPending) return;
+        if (exchange->attempt && steadyMilliseconds() >= exchange->attemptDeadlineMs) {
+            exchange->ticketPending = false;
+            return;
+        }
+        ticket = exchange->ticket;
+        frame = exchange->ticketFrame;
+        operationId = exchange->ticketOperationId;
+    }
+    {
+        std::lock_guard<std::mutex> lock(exchange->mutex);
+        if (exchange->submissions.size() >= 64) return;
+    }
+    QtRecoverySubmissionV1 submission{};
+    submission.size = sizeof(submission);
+    submission.version = QT_RECOVERY_SUBMISSION_ABI_VERSION;
+    if (!resolver->take(ticket.window_lifetime, generation->generation, frame.attempt, submission)) return;
+    if (submission.ticket.window_lifetime != ticket.window_lifetime ||
+        submission.ticket.scenegraph_generation != ticket.scenegraph_generation) {
+        std::lock_guard<std::mutex> lock(exchange->mutex);
+        if (exchange->owner.lock() == generation && sameFrame(exchange->ticketFrame, frame)) {
+            exchange->ticketPending = false;
+            exchange->submissions.clear();
+            exchange->bootstrapSupported = false;
+        }
+        return;
+    }
+    if (
+        submission.size != sizeof(submission) || submission.version != QT_RECOVERY_SUBMISSION_ABI_VERSION ||
+        submission.reserved || !submission.node_lifetime || !submission.texture_generation ||
+        !submission.fbo_content_serial || !submission.display_texture || !sameFrame(submission.frame, frame) ||
+        submission.ticket.frame_serial < ticket.frame_serial ||
+        submission.ticket.size != ticket.size || submission.ticket.version != ticket.version ||
+        !submission.ticket.render_thread || !submission.ticket.swapchain || !submission.ticket.render_target ||
+        !submission.ticket.surface || !submission.ticket.platform_context) return;
+    {
+        std::lock_guard<std::mutex> lock(exchange->mutex);
+        if (!generation->observerAuthority.load() || exchange->owner.lock() != generation ||
+            exchange->generation != generation->generation || exchange->attempt != frame.attempt ||
+            !exchange->ticketPending || !sameFrame(exchange->ticketFrame, frame) ||
+            exchange->ticketOperationId != operationId ||
+            submission.ticket.frame_serial <= exchange->lastQtFrameSerial || exchange->submissions.size() >= 64 ||
+            (frame.attempt && steadyMilliseconds() >= exchange->attemptDeadlineMs)) return;
+        exchange->lastQtFrameSerial = submission.ticket.frame_serial;
+        exchange->submission = submission;
+        exchange->submissions.push_back({submission, operationId});
+        exchange->sourceFrameSerial = submission.frame.source_frame_serial;
+        exchange->bootstrapSupported = true;
+    }
+    generation->notifyRenderUpdate();
