+            m_submissionResolver->publish(frame, ticket) &&
+            ticket.size == sizeof(ticket) && ticket.version == QT_RECOVERY_SWAP_ABI_VERSION &&
+            ticket.window_lifetime && ticket.scenegraph_generation && ticket.frame_serial;
+        bool published = false;
+        {
+            std::lock_guard<std::mutex> lock(m_exchange->mutex);
