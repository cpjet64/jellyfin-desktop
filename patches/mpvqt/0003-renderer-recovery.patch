+    initializeGeneration(new_obj);
+}
+
+bool MpvRenderer::initializeGeneration(MpvAbstractItem *new_obj)
+{
+    if (m_generation) return true;
+    if (!new_obj->d_ptr->core) return false;
+    static std::atomic<quint64> nextGeneration{1};
+    auto generation = RendererRuntime::GenerationOwner::create(nextGeneration.fetch_add(1), new_obj->d_ptr->core);
+    if (generation && RendererRuntime::coordinator().retain(generation)) m_generation = std::move(generation);
+    else if (generation) generation->retireOnOriginalContext();
+    if (m_generation) {
+        std::lock_guard<std::mutex> lock(m_exchange->mutex);
+        m_exchange->install(m_generation, m_generation->generation);
+        new_obj->d_ptr->readySent = false;
+    }
+    if (auto *window = new_obj->window()) {
+        window->setPersistentSceneGraph(true);
+        if (m_generation) {
+            const auto generation = m_generation;
+            const auto exchange = m_exchange;
+            const auto resolver = m_submissionResolver;
+            m_frameEndConnection = QObject::connect(window, &QQuickWindow::afterFrameEnd, window,
+                [generation, exchange, resolver] { takeSubmission(generation, exchange, resolver); },
+                Qt::DirectConnection);
+        }
+    }
+    return static_cast<bool>(m_generation);
+}
+
+MpvRenderer::~MpvRenderer()
+{
+    if (!m_generation) return;
+    QObject::disconnect(m_frameEndConnection);
+    {
+        std::lock_guard<std::mutex> lock(m_exchange->mutex);
+        m_exchange->retireIfCurrent(m_generation, m_generation->generation,
+                                    [resolver = m_submissionResolver, window = m_windowLifetime] {
+            resolver->revoke(window);
+        });
+    }
+    if (m_generation->retireOnOriginalContext())
+        RendererRuntime::coordinator().releaseRetired(m_generation);
+    else
+        RendererRuntime::coordinator().quarantine(m_generation);
+}
+
+void MpvRenderer::synchronize(QQuickFramebufferObject *item)
+{
+    if (!m_generation && initializeGeneration(static_cast<MpvAbstractItem *>(item)))
+        invalidateFramebufferObject();
+    std::lock_guard<std::mutex> lock(m_exchange->mutex);
+    if (m_exchange->owner.lock() != m_generation) return;
+    m_exchange->generation = m_generation ? m_generation->generation : 0;
+}
+
+void MpvRenderer::acknowledgeUsability()
+{
+    if (!m_generation) return;
+    const auto now = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    bool result = false;
+    {
+        std::lock_guard<std::mutex> lock(m_exchange->mutex);
+        if (!m_exchange->owns(m_generation, m_generation->generation) ||
+            !m_exchange->requestId || m_exchange->requestGeneration != m_generation->generation) return;
+        const bool usable =
+            now < m_exchange->deadlineMs && m_generation->context &&
+            m_generation->originalThread == QThread::currentThread() &&
+            m_generation->originalContext == QOpenGLContext::currentContext() &&
+            m_generation->originalContext && m_generation->originalContext->isValid() &&
+            !m_generation->blocked.load();
+        result = m_exchange->recordUsability(m_generation, m_generation->generation, usable);
+    }
+    if (result) m_generation->notifyRenderUpdate();
+}
