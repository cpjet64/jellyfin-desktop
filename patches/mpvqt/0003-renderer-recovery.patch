+#else
+    if (!m_frameResolver.ownedSeekAvailable()) return m_frameResolver.render(m_generation->context, params);
+    const auto v2 = m_frameResolver.renderV2(m_generation->context, params);
+    RecoveryFrameBridge::RenderResult result{v2.error, v2.capabilityAvailable, {}};
+    if (v2.observation.valid == 1) {
+        const auto &source = v2.observation;
+        result.observation = {sizeof(RecoveryFrameObservationV1), RECOVERY_FRAME_OBSERVATION_VERSION,
+                              source.valid, source.reserved, source.playlist_entry_id,
