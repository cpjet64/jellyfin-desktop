+                    m_exchange->ticket = ticket;
+                    m_exchange->ticketFrame = frame;
+                    m_exchange->ticketOperationId = operationId;
+                    m_exchange->ticketPending = true;
+                    m_windowLifetime = ticket.window_lifetime;
+                }
+                published = true;
+            }
+        }
+        if (published) m_generation->notifyRenderUpdate();
