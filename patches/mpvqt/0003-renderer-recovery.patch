+        frame.version = QT_RECOVERY_SUBMISSION_ABI_VERSION;
+        frame.attempt = attempt;
+        frame.renderer_generation = m_generation->generation;
+        frame.entry_id = result.observation.playlist_entry_id;
+        frame.discontinuity_id = result.observation.discontinuity_id;
+        frame.source_frame_serial = result.observation.source_frame_serial;
+        frame.render_serial = result.observation.render_serial;
+        frame.media_pts = result.observation.media_pts;
