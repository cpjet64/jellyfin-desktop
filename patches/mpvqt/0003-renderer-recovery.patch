+void MpvRenderer::publishNativeRecord(const RecoveryFrameBridge::RenderResult &result, quint32 fbo,
+                                      quint64 attempt, qint64 attemptDeadline, quint64 operationId)
+{
+        QtRecoveryFrameV1 frame{};
