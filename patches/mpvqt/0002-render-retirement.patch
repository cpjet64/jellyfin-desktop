+        const bool closed = owner->service.close(generation, original, DiagnosticFailureInjection::monotonicNanos());
+        if (closed) {
+            DiagnosticFailureInjection::serviceCloseOrder = ++DiagnosticFailureInjection::order;
+            DiagnosticFailureInjection::serviceCloseNs = DiagnosticFailureInjection::monotonicNanos();
+        }
+        QMetaObject::invokeMethod(this, [this, owner, generation, closed] {
+            if (closed && owner->service.acknowledge(generation)) emit syntheticFrameServiceClosed(generation);
+            else emit syntheticFrameServiceCloseFailed(generation);
+        }, Qt::QueuedConnection);
+    }), QQuickWindow::BeforeRenderingStage);
+    update();
+    return true;
+}
