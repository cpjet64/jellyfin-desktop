+void MpvAbstractItem::requestRenderRetirement(quint64 generation)
+{
+    auto owner = d_ptr->renderOwner;
+    if (!owner->state.request(generation) || !window()) return;
+    int empty = 0;
+    const int closed = ++DiagnosticFailureInjection::order;
+    DiagnosticFailureInjection::closedOrder.compare_exchange_strong(empty, closed);
+    window()->scheduleRenderJob(QRunnable::create([this, owner, generation] {
+        const bool original = !DiagnosticFailureInjection::blockNextRetire.exchange(false) &&
+            owner->context && QThread::currentThread() == owner->originalThread &&
+            QOpenGLContext::currentContext() == owner->originalContext;
+        const auto result = owner->state.retire(generation, original,
+            [owner] {
+                DiagnosticFailureInjection::unregisterEnteredOrder = ++DiagnosticFailureInjection::order;
+                mpv_render_context_set_update_callback(owner->context, nullptr, nullptr);
+                DiagnosticFailureInjection::unregisteredOrder = ++DiagnosticFailureInjection::order;
+            },
+            [this, owner] {
+                mpv_render_context_free(owner->context);
+                ++DiagnosticFailureInjection::frees;
+                DiagnosticFailureInjection::freedOrder = ++DiagnosticFailureInjection::order;
+                owner->context = nullptr;
+                d_ptr->m_mpv_gl = nullptr;
+                DiagnosticFailureInjection::clearedOrder = ++DiagnosticFailureInjection::order;
+            });
+        if (result == RenderRetirementState::Result::Stale) return;
+        QMetaObject::invokeMethod(this, [this, generation, result] {
+            if (result == RenderRetirementState::Result::Retired) {
+                DiagnosticFailureInjection::ackOrder = ++DiagnosticFailureInjection::order;
+                emit renderRetired(generation);
+            }
+            else emit renderRetirementBlocked(generation);
+        }, Qt::QueuedConnection);
+    }), QQuickWindow::BeforeRenderingStage);
+    update();
