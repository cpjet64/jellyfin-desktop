+bool MpvAbstractItem::requestSyntheticFrameServiceClose(quint64 generation, bool terminalConfirmed)
+{
+    auto owner = std::atomic_load(&d_ptr->renderOwner);
+    if (!window() || !owner->service.requestClose(generation, terminalConfirmed,
+                                                   DiagnosticFailureInjection::monotonicNanos())) return false;
+    window()->scheduleRenderJob(QRunnable::create([this, owner, generation] {
+        const bool original = owner->context && QThread::currentThread() == owner->originalThread &&
