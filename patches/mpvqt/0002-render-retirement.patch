+MpvAbstractItem::CreationRequest MpvAbstractItem::requestRenderCreation(quint64 generation)
+{
+    if (!d_ptr->retirementAcknowledged || generation != d_ptr->visibleGeneration.load())
+        return CreationRequest::NotRetired;
+    if (d_ptr->creationRequested) return CreationRequest::AlreadyRequested;
+    if (!window()) return CreationRequest::NoWindow;
+    d_ptr->creationRequested = true;
+    auto oldOwner = std::atomic_load(&d_ptr->renderOwner);
+    window()->scheduleRenderJob(QRunnable::create([this, oldOwner, generation] {
+        if (!oldOwner->originalContext || QOpenGLContext::currentContext() != oldOwner->originalContext ||
+            QThread::currentThread() != oldOwner->originalThread) {
+            QMetaObject::invokeMethod(this, [this, generation] { emit renderCreationBlocked(generation); }, Qt::QueuedConnection);
+            return;
+        }
+        auto owner = std::make_shared<DiagnosticRenderOwner>(nextGeneration.fetch_add(1), this);
+        std::atomic_store(&d_ptr->renderOwner, owner);
+        d_ptr->visibleGeneration = owner->generation;
+        const int result = createDiagnosticRenderContext();
+        if (result < 0) {
+            QMetaObject::invokeMethod(this, [this, generation, owner, result] {
+                emit renderCreationFailedNoContext(generation, owner->generation, result);
+            }, Qt::QueuedConnection);
+            return;
+        }
+        QMetaObject::invokeMethod(this, [this, generation, owner] {
+            d_ptr->retirementAcknowledged = false;
+            emit renderCreated(generation, owner->generation);
+        }, Qt::QueuedConnection);
+    }), QQuickWindow::BeforeRenderingStage);
+    update();
+    return CreationRequest::Accepted;
+}
