+static qint64 recoverySteadyMilliseconds()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+void MpvAbstractItem::refreshRecoveryBootstrap()
+{
+    if (d_ptr->core || d_ptr->bootstrapFailed) return;
+    const auto now = recoverySteadyMilliseconds();
+    if (!d_ptr->bootstrapDeadlineMs) d_ptr->bootstrapDeadlineMs = now + 15000;
+    if (d_ptr->bootstrapToken) RendererRuntime::cancelCoreReservation(d_ptr->bootstrapToken);
+    d_ptr->bootstrapToken = 0;
+    const auto revision = ++d_ptr->bootstrapRevision;
+    if (!revision || now >= d_ptr->bootstrapDeadlineMs) {
+        expireRecoveryBootstrap(revision);
+        return;
+    }
+    QPointer<MpvAbstractItem> guard(this);
+    auto callback = [guard](RendererRuntime::AdmissionStatus status, quint64 token, quint64 revision) {
+        if (!guard || guard->d_ptr->bootstrapRevision != revision || guard->d_ptr->bootstrapToken != token) {
+            RendererRuntime::cancelCoreReservation(token);
+            return;
+        }
+        if (status == RendererRuntime::AdmissionStatus::Reserved)
+            guard->completeRecoveryBootstrap(token, revision);
+        else
+            guard->failRecoveryBootstrap(revision);
+    };
+    const auto result = RendererRuntime::reserveCore(this, revision, std::move(callback));
+    d_ptr->bootstrapToken = result.token;
+    if (result.status == RendererRuntime::AdmissionStatus::Reserved) {
+        completeRecoveryBootstrap(result.token, revision);
+    }
+    if (result.status == RendererRuntime::AdmissionStatus::Deferred ||
+        result.status == RendererRuntime::AdmissionStatus::Reserved) {
+        QTimer::singleShot(static_cast<int>(d_ptr->bootstrapDeadlineMs - now), this,
+                           [guard, revision] { if (guard) guard->expireRecoveryBootstrap(revision); });
+    } else {
+        failRecoveryBootstrap(revision);
+    }
+}
+
+void MpvAbstractItem::restrictRecoveryBootstrapDeadline(qint64 deadline)
+{
+    if (d_ptr->core || d_ptr->bootstrapFailed) return;
+    if (deadline <= recoverySteadyMilliseconds()) {
+        failRecoveryBootstrap(d_ptr->bootstrapRevision);
+        return;
+    }
+    if (!d_ptr->bootstrapDeadlineMs || deadline < d_ptr->bootstrapDeadlineMs) {
+        d_ptr->bootstrapDeadlineMs = deadline;
+        refreshRecoveryBootstrap();
+    }
+}
+
+void MpvAbstractItem::suspendRecoveryBootstrap()
+{
+    if (d_ptr->core || d_ptr->bootstrapFailed) return;
+    if (d_ptr->bootstrapToken) RendererRuntime::cancelCoreReservation(d_ptr->bootstrapToken);
+    d_ptr->bootstrapToken = 0;
+    const auto revision = ++d_ptr->bootstrapRevision;
+    if (!revision) failRecoveryBootstrap(revision);
+    else expireRecoveryBootstrap(revision);
+}
+
+void MpvAbstractItem::expireRecoveryBootstrap(quint64 revision)
+{
+    if (revision != d_ptr->bootstrapRevision || d_ptr->core || d_ptr->bootstrapFailed) return;
+    const auto remaining = d_ptr->bootstrapDeadlineMs - recoverySteadyMilliseconds();
+    if (remaining > 0) {
+        QPointer<MpvAbstractItem> guard(this);
+        QTimer::singleShot(static_cast<int>(remaining), this,
+                           [guard, revision] { if (guard) guard->expireRecoveryBootstrap(revision); });
+        return;
+    }
+    failRecoveryBootstrap(revision);
+}
+
+bool MpvAbstractItem::recoveryBootstrapUnavailable() const
+{
+    return d_ptr->bootstrapFailed;
+}
+
+bool MpvAbstractItem::recoveryBootstrapInFlightCurrent() const
+{
+    return d_ptr->bootstrapInFlightRevision && d_ptr->bootstrapInFlightRevision == d_ptr->bootstrapRevision;
+}
+
+void MpvAbstractItem::failRecoveryBootstrap(quint64 revision)
+{
+    if (revision != d_ptr->bootstrapRevision || d_ptr->core || d_ptr->bootstrapFailed) return;
+    if (d_ptr->bootstrapToken) RendererRuntime::cancelCoreReservation(d_ptr->bootstrapToken);
+    d_ptr->bootstrapToken = 0;
+    d_ptr->bootstrapFailed = true;
+    emit recoveryBootstrapFailed();
+}
+
+void MpvAbstractItem::completeRecoveryBootstrap(quint64 reservation, quint64 revision)
+{
+    if (revision != d_ptr->bootstrapRevision || reservation != d_ptr->bootstrapToken ||
+        recoverySteadyMilliseconds() >= d_ptr->bootstrapDeadlineMs) {
+        RendererRuntime::cancelCoreReservation(reservation);
+        expireRecoveryBootstrap(revision);
+        return;
+    }
+    d_ptr->bootstrapToken = 0;
+    d_ptr->bootstrapInFlightRevision = revision;
+    QPointer<MpvAbstractItem> guard(this);
+    MpvRecoveryBootstrap::start(reservation, revision, d_ptr->mode,
+        [guard](std::shared_ptr<RendererRuntime::CoreOwner> owner, quint64 resultRevision) {
+            return guard && guard->acceptRecoveryBootstrap(owner, resultRevision);
+        });
+}
