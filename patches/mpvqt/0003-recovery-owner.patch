+void MpvAbstractItem::deliverRecoveryNotifications(quint64 generation)
+{
+        bool ready = false, result = false, usable = false, contextFailure = false, framePending = false;
+        bool submissionPending = false;
+        bool capabilityFailure = false;
+        RecoveryFrameObservationV1 frame{};
+        QtRecoverySubmissionV1 submission{};
+        quint64 operationId = 0;
+        quint64 resultGeneration = 0, resultId = 0;
+        {
+            std::lock_guard<std::mutex> lock(d_ptr->exchange->mutex);
+            if (generation != d_ptr->exchange->generation) return;
+            auto owner = d_ptr->exchange->owner.lock();
+            if (!owner || owner->generation != generation || !owner->observerAuthority.load()) return;
+            ready = d_ptr->exchange->ready && d_ptr->exchange->readyGeneration == generation && !d_ptr->readySent;
+            d_ptr->readySent |= ready;
+            result = d_ptr->exchange->resultPending && d_ptr->exchange->resultGeneration == generation;
+            resultGeneration = d_ptr->exchange->resultGeneration;
+            resultId = d_ptr->exchange->resultId;
+            usable = d_ptr->exchange->resultUsable;
+            d_ptr->exchange->resultPending = false;
+            contextFailure = d_ptr->exchange->contextFailurePending &&
+                d_ptr->exchange->contextFailureGeneration == generation;
+            d_ptr->exchange->contextFailurePending = false;
+            capabilityFailure = d_ptr->exchange->capabilityFailurePending &&
+                d_ptr->exchange->capabilityFailureGeneration == generation;
+            d_ptr->exchange->capabilityFailurePending = false;
+            framePending = d_ptr->exchange->framePending && owner && owner->observerAuthority.load() &&
+                owner->generation == generation && d_ptr->exchange->frameGeneration == generation;
+            if (framePending) frame = d_ptr->exchange->frame;
+            d_ptr->exchange->framePending = false;
+            const auto now = std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count();
+            if (d_ptr->exchange->attempt && now >= d_ptr->exchange->attemptDeadlineMs) {
+                d_ptr->exchange->ticketPending = false;
+                d_ptr->exchange->submissions.clear();
+            }
+            if (!d_ptr->exchange->submissions.empty()) {
+                submission = d_ptr->exchange->submissions.front().submission;
+                operationId = d_ptr->exchange->submissions.front().operationId;
+                d_ptr->exchange->submissions.pop_front();
+                submissionPending = owner && owner->observerAuthority.load() &&
+                    submission.frame.renderer_generation == generation &&
+                    submission.frame.attempt == d_ptr->exchange->attempt;
+            }
+        }
+        if (ready) emit this->ready();
+        if (result) emit rendererUsabilityResult(resultGeneration, resultId, usable);
+        if (contextFailure) emit rendererContextUnavailable(generation);
+        if (capabilityFailure) emit recoveryCapabilityUnavailable(generation);
+        if (framePending) emit recoveryFrameRendered(generation, frame);
+        if (submissionPending) emit recoveryFrameSubmission(generation, submission);
+        if (submissionPending && operationId)
+            emit recoveryFrameSubmissionOperation(generation, submission, operationId);
+        update();
