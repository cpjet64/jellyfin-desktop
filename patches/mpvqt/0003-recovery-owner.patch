+            d_ptr->exchange->capabilityFailurePending = false;
+            framePending = d_ptr->exchange->framePending && owner && owner->observerAuthority.load() &&
+                owner->generation == generation && d_ptr->exchange->frameGeneration == generation;
+            if (framePending) frame = d_ptr->exchange->frame;
