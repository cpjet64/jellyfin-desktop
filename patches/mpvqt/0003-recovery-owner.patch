+bool MpvAbstractItem::initializeRecoveryOwner(MpvController::EventMode mode, quint64 reservation)
+{
+    auto *relay = new RendererRuntime::WakeRelay;
+    relay->moveToThread(d_ptr->m_workerThread);
+    auto *lifecycleDispatcher = QCoreApplication::instance();
+    if (lifecycleDispatcher) {
+        static bool shutdownConnected = false;
+        if (!shutdownConnected) {
+            connect(lifecycleDispatcher, &QCoreApplication::aboutToQuit, lifecycleDispatcher,
+                    [lifecycleDispatcher] { RendererRuntime::closeAdmissionDispatcher(lifecycleDispatcher); },
+                    Qt::DirectConnection);
+            shutdownConnected = true;
+        }
+    }
+    d_ptr->core = RendererRuntime::CoreOwner::adoptReserved(reservation, d_ptr->m_mpv, d_ptr->m_mpvController,
+                                                            d_ptr->m_workerThread, relay, lifecycleDispatcher);
+    if (!d_ptr->core) {
+        struct FailedAdoption {
+            MpvController *controller;
+            QThread *worker;
+            mpv_handle *native;
+            RendererRuntime::WakeRelay *relay;
+        };
+        auto *controller = d_ptr->m_mpvController;
+        auto *worker = d_ptr->m_workerThread;
+        auto *storage = new FailedAdoption{controller, worker, d_ptr->m_mpv, relay};
+        connect(worker, &QThread::finished, controller, &QObject::deleteLater);
+        connect(worker, &QThread::finished, worker, &QObject::deleteLater);
+        QMetaObject::invokeMethod(controller, [storage] {
+            if (storage->native) {
+                mpv_set_wakeup_callback(storage->native, nullptr, nullptr);
+                mpv_terminate_destroy(storage->native);
+            }
+            storage->relay->deleteLater();
+            storage->controller->deleteLater();
+            storage->worker->quit();
+            delete storage;
+        }, Qt::QueuedConnection);
+        d_ptr->m_mpvController = nullptr;
+        d_ptr->m_workerThread = nullptr;
+        d_ptr->m_mpv = nullptr;
+        return false;
+    }
+    const auto owner = d_ptr->core;
+    if (!QMetaObject::invokeMethod(d_ptr->m_mpvController, [owner, controller = d_ptr->m_mpvController] {
+            controller->bindRecoveryCore(owner);
+        }, Qt::BlockingQueuedConnection)) {
+        owner->requestFinalization();
+        d_ptr->core.reset();
+        d_ptr->m_mpvController = nullptr;
+        d_ptr->m_workerThread = nullptr;
+        d_ptr->m_mpv = nullptr;
+        return false;
+    }
+    connect(relay, &RendererRuntime::WakeRelay::renderUpdateRequested, this,
+            &MpvAbstractItem::deliverRecoveryNotifications, Qt::QueuedConnection);
+    if (mode == MpvController::EventMode::External)
+        d_ptr->core->installExternalWakeup();
+    return true;
+}
