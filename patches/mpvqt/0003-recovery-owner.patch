+            if (generation != d_ptr->exchange->generation) return;
+            ready = d_ptr->exchange->ready && !d_ptr->readySent;
+            d_ptr->readySent |= ready;
+            result = d_ptr->exchange->resultPending;
+            resultGeneration = d_ptr->exchange->resultGeneration;
+            resultId = d_ptr->exchange->resultId;
+            usable = d_ptr->exchange->resultUsable;
+            d_ptr->exchange->resultPending = false;
