diff --git a/src/plugins/platforms/windows/qwindowsglcontext.cpp b/src/plugins/platforms/windows/qwindowsglcontext.cpp
--- a/src/plugins/platforms/windows/qwindowsglcontext.cpp
+++ b/src/plugins/platforms/windows/qwindowsglcontext.cpp
@@ -14,3 +14,4 @@
 #include <qpa/qplatformnativeinterface.h>
 #include <private/qsystemlibrary_p.h>
+#include "../../../gui/recovery/QtRecoveryAbi.h"
 #include <algorithm>
@@ -1248,5 +1249,19 @@ void QWindowsGLContext::swapBuffers(QPlatformSurface *surface)
-    if (const QOpenGLContextData *contextData = findByHWND(m_windowContexts, handleOf(surface)))
-        QOpenGLStaticContext::opengl32.swapBuffers(contextData->hdc);
-    else
+    if (const QOpenGLContextData *contextData = findByHWND(m_windowContexts, handleOf(surface))) {
+        PIXELFORMATDESCRIPTOR descriptor{};
+        const int format = GetPixelFormat(contextData->hdc);
+        const bool described = format && DescribePixelFormat(contextData->hdc, format,
+                                                               sizeof(descriptor), &descriptor);
+        const bool doubleBuffered = described && (descriptor.dwFlags & PFD_DOUBLEBUFFER)
+                && (descriptor.dwFlags & PFD_DRAW_TO_WINDOW);
+        const bool current = QOpenGLStaticContext::opengl32.wglGetCurrentContext()
+                    == contextData->renderingContext
+                && QOpenGLStaticContext::opengl32.wglGetCurrentDC() == contextData->hdc;
+        const BOOL result = QOpenGLStaticContext::opengl32.swapBuffers(contextData->hdc);
+        qt_recovery_swap_report_v1(reinterpret_cast<uintptr_t>(surface->surface()),
+                                   reinterpret_cast<uintptr_t>(static_cast<QPlatformOpenGLContext *>(this)),
+                                   current && !QOpenGLStaticContext::opengl32.moduleIsNotOpengl32(),
+                                   doubleBuffered, result != FALSE);
+    } else {
         qWarning("%s: Cannot find window %p", __FUNCTION__, handleOf(surface));
+    }
 }
