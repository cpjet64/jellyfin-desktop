@@ -352,0 +357,18 @@ struct DrawSet
+#if defined(Q_OS_WIN) && QT_CONFIG(opengl)
+    quint64 recoveryNodes[4] = {};
+    bool recoveryOverflow = false;
+    void addRecoveryNode(quint64 node)
+    {
+        if (!node)
+            return;
+        for (auto &entry : recoveryNodes) {
+            if (entry == node)
+                return;
+            if (!entry) {
+                entry = node;
+                return;
+            }
+        }
+        recoveryOverflow = true;
+    }
