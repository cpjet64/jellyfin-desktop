diff --git a/test/recovery_seek_epoch.c b/test/recovery_seek_epoch.c
new file mode 100644
index 0000000..f6bf52f
--- /dev/null
+++ b/test/recovery_seek_epoch.c
@@ -0,0 +1,56 @@
+#include <stdlib.h>
+#include <stdint.h>
+#include "player/recovery_seek_epoch.h"
+
+#define CHECK(condition) do { if (!(condition)) abort(); } while (0)
+
+static void pending_cancel_and_supersession(void)
+{
+    atomic_uint_fast64_t state = ATOMIC_VAR_INIT(0);
+    uint64_t first = recovery_epoch_next(&state);
+    uint64_t replacement = recovery_epoch_next(&state);
+    CHECK(first && replacement && first != replacement);
+    CHECK(!recovery_epoch_claim(&state, first));
+    CHECK(recovery_epoch_claim(&state, replacement));
+    CHECK(recovery_epoch_applied(&state, replacement));
+    CHECK(recovery_epoch_next(&state));
+    CHECK(!recovery_epoch_applied(&state, replacement));
+    CHECK(!recovery_epoch_claim(&state, replacement));
+}
+
+static void application_and_cancel_order(void)
+{
+    atomic_uint_fast64_t state = ATOMIC_VAR_INIT(0);
+    uint64_t cancelled = recovery_epoch_next(&state);
+    CHECK(recovery_epoch_next(&state));
+    CHECK(!recovery_epoch_claim(&state, cancelled));
+    uint64_t claimed = recovery_epoch_next(&state);
+    CHECK(recovery_epoch_claim(&state, claimed));
+    CHECK(!recovery_epoch_claim(&state, claimed));
+    CHECK(recovery_epoch_applied(&state, claimed));
+    CHECK(recovery_epoch_next(&state));
+    CHECK(!recovery_epoch_applied(&state, claimed));
+    CHECK(!recovery_epoch_claim(&state, 0));
+    CHECK(!recovery_epoch_claim(&state, claimed | 1));
+}
+
+static void exhaustion_is_terminal(void)
+{
+    atomic_uint_fast64_t state = ATOMIC_VAR_INIT(UINT64_MAX - 3);
+    CHECK(recovery_epoch_claim(&state, UINT64_MAX - 3));
+    CHECK(recovery_epoch_applied(&state, UINT64_MAX - 3));
+    CHECK(!recovery_epoch_next(&state));
+    CHECK(atomic_load(&state) == UINT64_MAX);
+    CHECK(!recovery_epoch_applied(&state, UINT64_MAX - 1));
+    CHECK(!recovery_epoch_applied(&state, UINT64_MAX - 3));
+    CHECK(!recovery_epoch_next(&state));
+    CHECK(!recovery_epoch_claim(&state, UINT64_MAX - 3));
+}
+
+int main(void)
+{
+    pending_cancel_and_supersession();
+    application_and_cancel_order();
+    exhaustion_is_terminal();
+    return 0;
+}
