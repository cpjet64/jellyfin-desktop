diff --git a/player/recovery_seek_epoch.h b/player/recovery_seek_epoch.h
new file mode 100644
index 0000000..aa7c644
--- /dev/null
+++ b/player/recovery_seek_epoch.h
@@ -0,0 +1,36 @@
+#ifndef MP_RECOVERY_SEEK_EPOCH_H
+#define MP_RECOVERY_SEEK_EPOCH_H
+
+#include <stdbool.h>
+#include <stdatomic.h>
+#include <stdint.h>
+
+/* Even epochs are pending; the low bit marks an application claim. */
+static inline uint64_t recovery_epoch_next(atomic_uint_fast64_t *state)
+{
+    uint_fast64_t old = atomic_load(state);
+    for (;;) {
+        if (old == UINT64_MAX)
+            return 0;
+        uint_fast64_t next = old >= UINT64_MAX - 2 ? UINT64_MAX :
+            (old & ~(uint_fast64_t)1) + 2;
+        if (atomic_compare_exchange_weak(state, &old, next))
+            return next == UINT64_MAX ? 0 : next;
+    }
+}
+
+static inline bool recovery_epoch_claim(atomic_uint_fast64_t *state, uint64_t epoch)
+{
+    if (!epoch || epoch >= UINT64_MAX - 1 || (epoch & 1))
+        return false;
+    uint_fast64_t expected = epoch;
+    return atomic_compare_exchange_strong(state, &expected, epoch | 1);
+}
+
+static inline bool recovery_epoch_applied(atomic_uint_fast64_t *state, uint64_t epoch)
+{
+    return epoch && epoch < UINT64_MAX - 1 && !(epoch & 1) &&
+           atomic_load(state) == (epoch | 1);
+}
+
+#endif
