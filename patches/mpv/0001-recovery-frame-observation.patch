+
+int mpv_render_context_render_recovery_v1(mpv_render_context *ctx,
+                                          mpv_render_param *params,
+                                          RecoveryFrameObservationV1 *observation)
+{
+    if (!ctx || !observation || observation->size != sizeof(*observation) ||
+        observation->version != RECOVERY_FRAME_OBSERVATION_VERSION)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *observation = (RecoveryFrameObservationV1){
+        .size = sizeof(*observation), .version = RECOVERY_FRAME_OBSERVATION_VERSION,
+    };
+    return render_with_recovery(ctx, params, observation);
+}
