+static void recovery_queue_frame(struct MPContext *mpctx, struct vo *vo,
+                                 struct vo_frame *frame)
+{
+    if (!mpctx->recovery_discontinuity)
+        mpctx->recovery_discontinuity = 1;
+    if (frame->current && mpctx->playing && mpctx->playing->id &&
+        mpctx->playing->id <= INT64_MAX && mpctx->recovery_discontinuity != UINT64_MAX &&
+        mpctx->recovery_source_serial < UINT64_MAX) {
+        frame->recovery_entry_id = mpctx->playing->id;
+        frame->recovery_discontinuity = mpctx->recovery_discontinuity;
+        frame->recovery_source_serial = ++mpctx->recovery_source_serial;
+        frame->recovery_media_pts = frame->current->pts;
+    }
+    vo_queue_frame(vo, frame);
+}
