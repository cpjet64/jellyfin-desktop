index 00000000..38affe58
--- /dev/null
+++ b/include/mpv/recovery_frame_observation.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MPV_RECOVERY_FRAME_OBSERVATION_H
+#define MPV_RECOVERY_FRAME_OBSERVATION_H
+
+#include <stdint.h>
+#include "render.h"
+
+#define RECOVERY_FRAME_OBSERVATION_VERSION 1u
+
+typedef struct RecoveryFrameObservationV1 {
+    uint32_t size;
+    uint32_t version;
+    uint32_t valid;
+    uint32_t reserved;
+    uint64_t playlist_entry_id;
+    uint64_t discontinuity_id;
+    uint64_t source_frame_serial;
+    uint64_t render_serial;
+    double media_pts;
+} RecoveryFrameObservationV1;
+
+MPV_EXPORT int mpv_render_context_render_recovery_v1(
+    mpv_render_context *ctx, mpv_render_param *params,
+    RecoveryFrameObservationV1 *observation);
+
+#endif
