+struct recovery_seek_request {
+    struct MPContext *mpctx;
+    mpv_handle *reply_ctx;
+    uint64_t userdata, epoch, operation, entry;
+    int64_t target_ms;
+};
+
+static void recovery_seek_fn(void *data)
+{
+    struct recovery_seek_request *req = data;
+    struct MPContext *mpctx = req->mpctx;
+    bool accepted = atomic_load(&mpctx->recovery_seek_epoch) == req->epoch &&
+        mpctx->playing && mpctx->playing->id == req->entry &&
+        mpctx->stop_play == KEEP_PLAYING && mpctx->demuxer;
+    if (accepted) {
+        mpctx->recovery_owned_queue = true;
+        queue_seek(mpctx, MPSEEK_ABSOLUTE, req->target_ms / 1000.0, MPSEEK_EXACT, 0);
+        mpctx->recovery_owned_queue = false;
+        mpctx->recovery_pending_epoch = req->epoch;
+        mpctx->recovery_pending_entry = req->entry;
+        mpctx->recovery_pending_operation = req->operation;
+    }
+    struct mpv_event_command *result = talloc_zero(NULL, struct mpv_event_command);
+    struct mpv_event reply = { .event_id = MPV_EVENT_COMMAND_REPLY, .data = result,
+        .error = accepted ? 0 : MPV_ERROR_COMMAND };
+    send_reply(req->reply_ctx, req->userdata, &reply);
+    talloc_free(req);
+}
+
+int mpv_recovery_seek_async_v1(mpv_handle *ctx, uint64_t userdata,
+                               uint64_t operation, uint64_t entry, int64_t target_ms)
+{
+    if (!ctx || !operation || !entry || entry > INT64_MAX || target_ms < 0)
+        return MPV_ERROR_INVALID_PARAMETER;
+    if (!ctx->mpctx->initialized)
+        return MPV_ERROR_UNINITIALIZED;
+    int error = reserve_reply(ctx);
+    if (error < 0)
+        return error;
+    uint64_t epoch = recovery_next_epoch(ctx->mpctx);
+    struct recovery_seek_request *req = talloc_ptrtype(NULL, req);
+    *req = (struct recovery_seek_request){ctx->mpctx, ctx, userdata, epoch,
+                                         operation, entry, target_ms};
+    mp_dispatch_enqueue(ctx->mpctx->dispatch, recovery_seek_fn, req);
+    return 0;
+}
+
+int mpv_recovery_seek_cancel_v1(mpv_handle *ctx)
+{
+    if (!ctx)
+        return MPV_ERROR_INVALID_PARAMETER;
+    return recovery_next_epoch(ctx->mpctx) ? 0 : MPV_ERROR_GENERIC;
+}
