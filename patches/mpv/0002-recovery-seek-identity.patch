+/* Even values are pending epochs; odd values have claimed application. */
+static inline uint64_t recovery_next_epoch(struct MPContext *mpctx)
+{
+    uint_fast64_t old = atomic_load(&mpctx->recovery_seek_epoch);
+    for (;;) {
+        if (old == UINT64_MAX)
+            return 0;
+        uint_fast64_t next = old >= UINT64_MAX - 2 ? UINT64_MAX :
+            (old & ~(uint_fast64_t)1) + 2;
+        if (atomic_compare_exchange_weak(&mpctx->recovery_seek_epoch, &old, next))
+            return next == UINT64_MAX ? 0 : next;
+    }
+}
