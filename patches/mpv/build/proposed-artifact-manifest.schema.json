{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jellyfin-desktop:proposed-custom-mpv-artifact-manifest:1",
  "title": "Proposed custom mpv artifact manifest, not a build lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_lock_sha256", "provider_commit", "mpv_commit", "runtime_dependency_profile", "bridge_patches", "producer", "qt_kit", "variants"],
  "properties": {
    "schema_version": {"const": 1},
    "input_lock_sha256": {"$ref": "#/$defs/sha256"},
    "provider_commit": {"const": "1f8d2e76255abc48f0456d9be99b4cab9c6566e6"},
    "mpv_commit": {"const": "01e2533f3143b8940857ca419b0b367f583e05ca"},
    "runtime_dependency_profile": {"const": "windows-static-nonsystem"},
    "bridge_patches": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "sha256"],
        "properties": {"name": {"type": "string", "pattern": "^[0-9]{4}-[a-z0-9-]+\\.patch$"}, "sha256": {"$ref": "#/$defs/sha256"}}
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "toolchain_lock_sha256", "host_tool_lock_sha256", "build_configuration_sha256"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "toolchain_lock_sha256": {"$ref": "#/$defs/sha256"},
        "host_tool_lock_sha256": {"$ref": "#/$defs/sha256"},
        "build_configuration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qt_kit": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "configuration_sha256", "configuration_file", "source_patches", "artifacts"],
      "properties": {
        "version": {"const": "6.9.3"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_file": {"$ref": "#/$defs/artifact"},
        "source_patches": {
          "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256", "git_blob"],
            "properties": {
              "path": {"enum": [
                "patches/qt/base/QtRecoverySwap.cpp", "patches/qt/base/qtbase-6.9.3-swap.patch", "patches/qt/base/source-identity.txt",
                "patches/qt/quick/QtRecoveryBatchUpload.cpp", "patches/qt/quick/QtRecoveryClipState_p.h", "patches/qt/quick/QtRecoveryDrawSet_p.h",
                "patches/qt/quick/QtRecoveryPrimitive.cpp", "patches/qt/quick/QtRecoveryPrimitive_p.h", "patches/qt/quick/QtRecoveryQuick.cpp",
                "patches/qt/quick/QtRecoveryQuick_p.h", "patches/qt/quick/QtRecoverySubmissionAbi.h", "patches/qt/quick/QtRecoveryUploadDebug.cpp",
                "patches/qt/quick/qtdeclarative-6.9.3-batch-renderer.patch", "patches/qt/quick/qtdeclarative-6.9.3-ticket-fbo.patch", "patches/qt/runtime/QtRecoveryAbi.h"
              ]},
              "sha256": {"$ref": "#/$defs/sha256"},
              "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "variants": {
      "type": "object", "additionalProperties": false, "required": ["x86_64", "x86_64_v3"],
      "properties": {
        "x86_64": {"allOf": [{"$ref": "#/$defs/variant"}, {"properties": {"cpu_baseline": {"const": "x86-64"}}}]},
        "x86_64_v3": {"allOf": [{"$ref": "#/$defs/variant"}, {"properties": {"cpu_baseline": {"const": "x86-64-v3"}}}]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_baseline", "target_triple", "crt", "configuration_sha256", "dll", "msvc_import_library", "headers", "dependency_closure", "system_imports", "public_exports", "private_exports", "features"],
      "properties": {
        "cpu_baseline": {"enum": ["x86-64", "x86-64-v3"]},
        "target_triple": {"type": "string", "minLength": 1},
        "crt": {"type": "string", "minLength": 1},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "dll": {"$ref": "#/$defs/artifact"},
        "msvc_import_library": {"$ref": "#/$defs/artifact"},
        "headers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "dependency_closure": {"type": "array", "maxItems": 0},
        "system_imports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "public_exports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "contains": {"const": "mpv_render_context_render"}},
        "private_exports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "contains": {"const": "mpv_render_context_render_recovery_v1"}},
        "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
