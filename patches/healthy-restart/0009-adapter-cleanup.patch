+++ b/fixture_restart/FixtureRestartAdapter.cpp
@@ -40,0 +41,63 @@ FixtureRestartAdapter::FixtureRestartAdapter(PlayerComponent& player, FixtureRes
+bool FixtureRestartAdapter::bindCleanupGate(std::shared_ptr<const FixtureRestart::ChildGate> gate)
+{
+  if (!gate || gate.get() != &gate_ || cleanupGate_ || !player_.healthyBindRestoreCleanupGate(gate)) return false;
+  cleanupGate_ = std::move(gate);
+  return true;
+}
+
+FixtureRestart::RestartChild::ArmResult FixtureRestartAdapter::armActual()
+{
+  using Result = FixtureRestart::RestartChild::ArmResult;
+#ifdef MPVQT_EXTERNAL_EVENTS
+  if (!cleanupGate_ || cleanupGate_.get() != &gate_ || armIdentity_.attempt) return {};
+  if (gate_.canceled()) {
+    const auto receipt = player_.m_nativeReceipts.snapshot();
+    if (!player_.m_nativeRestore.armed && !player_.m_nativeRestore.loadAttempted &&
+        !player_.m_nativeRestore.seekAttempted && !player_.m_restoreUnpause.attempted && !player_.m_nativeObservation.pending &&
+        !receipt.key.attempt && !receipt.consumed && !player_.m_lastReceiptAttempt)
+      return {Result::Status::NotArmed, {}};
+    return {};
+  }
+  if (!arm()) return {};
+  const auto key = player_.m_nativeRestore.key;
+  const auto intent = player_.m_playbackIntent.snapshot();
+  if (!player_.m_nativeRestore.armed || !key.host || !key.core || !key.revision || !key.attempt ||
+      key.host != player_.m_receiptHost || key.core != player_.m_mpvGeneration || key.revision != intent.revision ||
+      key.host != host_ || key.attempt != attempt_) return {};
+  armIdentity_ = {key.host, key.core, key.revision, key.attempt};
+  return {Result::Status::Armed, armIdentity_};
+#else
+  return Result{};
+#endif
+}
+
+bool FixtureRestartAdapter::beginCleanup(quint64 sequence, quint64 cancelRevision, qint64 deadlineNs)
+{
+  if (!cleanupGate_ || !cleanupGate_->canceled() || !armIdentity_.attempt || !sequence ||
+      cancelRevision <= parentRevision_) return false;
+  const bool begun = player_.beginNativeRestoreCancellation(cleanupGate_, sequence, deadlineNs);
+  const auto& cleanup = player_.m_restoreCleanup;
+  return begun || (cleanup.claimed && cleanup.sequence == sequence && cleanup.key.host == armIdentity_.host &&
+      cleanup.key.core == armIdentity_.core && cleanup.key.revision == armIdentity_.intentRevision &&
+      cleanup.key.attempt == armIdentity_.attempt);
+}
+
+FixtureRestart::RestartChild::CleanupResult FixtureRestartAdapter::pollCleanup()
+{
+  using Result = FixtureRestart::RestartChild::CleanupResult;
+  using Status = PlayerComponent::RestoreCleanupStatus;
+  Result result;
+  result.identity = armIdentity_;
+  result.reason = FixtureRestart::CancelFailure::CleanupUnconfirmed;
+  if (!cleanupGate_ || !cleanupGate_->canceled() || !armIdentity_.attempt) return result;
+  const auto status = player_.pollNativeRestoreCancellation();
+  const auto key = player_.m_restoreCleanup.key;
+  if (key.host != armIdentity_.host || key.core != armIdentity_.core ||
+      key.revision != armIdentity_.intentRevision || key.attempt != armIdentity_.attempt) return result;
+  result.status = status == Status::Pending ? Result::Status::Pending :
+      status == Status::NoLoad ? Result::Status::NoLoad :
+      status == Status::Stopped ? Result::Status::Stopped : Result::Status::Failed;
+  if (result.status != Result::Status::Failed) result.reason = FixtureRestart::CancelFailure::None;
+  return result;
+}
