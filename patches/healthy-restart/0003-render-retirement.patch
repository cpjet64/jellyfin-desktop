+std::shared_ptr<HealthyRetirement::Lifetime> MpvRenderer::installHealthyLifetime(
+    QOpenGLContext *context, const std::shared_ptr<HealthyRetirement::Slot> &slot)
+{
+    const auto generation = slot->generation();
+    const QPointer<QOpenGLContext> original{context};
+    const auto identity = HealthyRetirement::Identity{
+        reinterpret_cast<std::uintptr_t>(QThread::currentThreadId()),
+        reinterpret_cast<std::uintptr_t>(context), generation};
+    if (!m_healthyToken->watchContext(context)) { slot->creationFailed(); return {}; }
+    HealthyRetirement::Operations operations;
+    operations.now = [] { return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count(); };
+    operations.currentIdentity = [original, generation] {
+        if (!original || !original->isValid()) return HealthyRetirement::Identity{};
+        return HealthyRetirement::Identity{reinterpret_cast<std::uintptr_t>(QThread::currentThreadId()),
+            reinterpret_cast<std::uintptr_t>(QOpenGLContext::currentContext()), generation};
+    };
+    operations.unregisterCallback = [](void *value) {
+        mpv_render_context_set_update_callback(static_cast<mpv_render_context *>(value), nullptr, nullptr);
+    };
+    operations.invalidateQueued = [](std::uint64_t) { return true; };
+    operations.freeContext = [](void *value) { mpv_render_context_free(static_cast<mpv_render_context *>(value)); };
+    operations.clearPointer = [item = m_mpvAItem](void *value) {
+        if (item->d_ptr->m_mpv_gl != value) return false;
+        item->d_ptr->m_mpv_gl = nullptr;
+        return true;
+    };
+    return slot->install(identity, m_mpvAItem->d_ptr->m_mpv_gl, std::move(operations));
