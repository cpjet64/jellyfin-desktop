+bool MpvAbstractItem::healthyWaitWorker(std::int64_t remainingNanoseconds)
+{
+    if (QThread::currentThread() == thread() || !d_ptr->m_workerThread || remainingNanoseconds <= 0)
+        return false;
+    const auto milliseconds = static_cast<std::uint64_t>(remainingNanoseconds / 1000000);
+    const auto limit = static_cast<std::uint64_t>(std::numeric_limits<unsigned long>::max() - 1);
+    const auto bounded = static_cast<unsigned long>(milliseconds < limit ? milliseconds : limit);
+    const bool joined = d_ptr->m_workerThread->wait(bounded);
+    if (joined) d_ptr->m_healthyJoined.store(true);
+    return joined;
+}
+
+void MpvAbstractItem::healthyDestroyCore()
+{
+    if (!d_ptr->m_healthyJoined.load() || d_ptr->m_healthyDestroyStarted.exchange(true) || !d_ptr->m_mpv)
+        throw std::logic_error("healthy core destruction is not permitted");
+    mpv_terminate_destroy(d_ptr->m_mpv);
+    d_ptr->m_healthyDestroyReturned.store(true);
+}
