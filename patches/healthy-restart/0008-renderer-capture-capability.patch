@@ -15,0 +17 @@
+#include <QOpenGLExtraFunctions>
@@ -21,0 +24,39 @@
+namespace {
+HealthyRetirement::FramebufferObservation captureAttachment(QOpenGLFramebufferObject *fbo)
+{
+    HealthyRetirement::FramebufferObservation observation;
+    auto *context = QOpenGLContext::currentContext();
+    if (!context || !context->isValid() || !fbo) return observation;
+    auto *gl = context->extraFunctions();
+    GLint bound = 0, type = 0, name = 0, level = -1, face = -1, layer = -1;
+    GLint old = 0, w = 0, h = 0;
+    if (gl->glGetError() != GL_NO_ERROR) return observation;
+    gl->glGetIntegerv(GL_FRAMEBUFFER_BINDING, &bound);
+    if (bound != static_cast<GLint>(fbo->handle())) return observation;
+    observation.bound = true;
+    gl->glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                               GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &type);
+    gl->glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                               GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &name);
+    if (type != GL_TEXTURE || name <= 0) return observation;
+    gl->glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                               GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_LEVEL, &level);
+    gl->glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                               GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_CUBE_MAP_FACE, &face);
+    gl->glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                               GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_LAYER, &layer);
+    if (gl->glGetError() != GL_NO_ERROR) return observation;
+    observation.level = level; observation.face = face; observation.layer = layer;
+    if (level != 0 || face != 0 || layer != 0) { observation.queried = true; return observation; }
+    gl->glGetIntegerv(GL_TEXTURE_BINDING_2D, &old);
+    gl->glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(name));
+    gl->glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &w);
+    gl->glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &h);
+    gl->glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(old));
+    if (gl->glGetError() != GL_NO_ERROR) return observation;
+    observation.attachment = (static_cast<std::uint64_t>(type) << 32) | static_cast<std::uint32_t>(name);
+    observation.width = w; observation.height = h; observation.queried = true;
+    return observation;
+}
+}
