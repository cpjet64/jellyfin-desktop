+HealthyRestart::AsyncStop::Status RestartSource::pollControl(const void* channel, QByteArray& response)
+{
+  using Status = HealthyRestart::AsyncStop::Status;
+  response.clear();
+  if (!stopAttempted_ || !beginAccepted_ || controlFailed_ || polling_ || acknowledged_ || channel != controlChannel_ || !pollStop_)
+    return Status::Failed;
+  Status status;
+  polling_ = true;
+  try { status = pollStop_(); }
+  catch (...) { polling_ = false; controlFailed_ = true; return Status::Failed; }
+  polling_ = false;
+  if (status == Status::Failed || status == Status::Unstarted) { controlFailed_ = true; return Status::Failed; }
+  if (status != Status::Complete) return status;
+  try { response = encodeControl({ControlKind::Ack, 1, revision_}); }
+  catch (...) { controlFailed_ = true; return Status::Failed; }
+  if (response.isEmpty()) { controlFailed_ = true; return Status::Failed; }
+  acknowledged_ = true;
+  return Status::Complete;
