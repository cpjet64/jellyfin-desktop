function(select_graphics opengl_found opengl_library gles_found gles_library)
  if(opengl_found AND opengl_library)
    set(PROBE_GRAPHICS_LIB "${opengl_library}" PARENT_SCOPE)
    set(PROBE_GRAPHICS_DEFINE PROBE_OPENGL PARENT_SCOPE)
  elseif(gles_found AND gles_library)
    set(PROBE_GRAPHICS_LIB "${gles_library}" PARENT_SCOPE)
    set(PROBE_GRAPHICS_DEFINE PROBE_GLES2 PARENT_SCOPE)
  else()
    message(FATAL_ERROR "OpenGL or GLES2 development inputs are required")
  endif()
endfunction()
function(require_qt_path path description)
  if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}")
    message(FATAL_ERROR "${description} is missing or not absolute: ${path}")
  endif()
  file(REAL_PATH "${path}" actual)
  file(REAL_PATH "${QTROOT}" selected)
  cmake_path(IS_PREFIX selected "${actual}" NORMALIZE within)
  if(NOT within)
    message(FATAL_ERROR "${description} resolves outside selected Qt: ${actual}")
  endif()
endfunction()

function(require_qt_target_location target)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Missing Qt target: ${target}")
  endif()
  get_target_property(location "${target}" IMPORTED_LOCATION_RELEASE)
  if(NOT location)
    get_target_property(location "${target}" IMPORTED_LOCATION)
  endif()
  require_qt_path("${location}" "${target}")
endfunction()
